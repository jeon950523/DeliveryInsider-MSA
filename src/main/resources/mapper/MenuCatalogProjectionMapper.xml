<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deliveryinsider.platform.domain.catalog.mapper.MenuCatalogProjectionMapper">

<resultMap
        id="menuCatalogProjectionResultMap"
        type="com.deliveryinsider.platform.domain.catalog.entity.MenuCatalogProjection">

    <id
            property="menuId"
            column="menu_id"/>

    <result
            property="storeId"
            column="store_id"/>

    <result
            property="status"
            column="status"/>

    <result
            property="menuEventVersion"
            column="menu_event_version"/>

</resultMap>

<select
id="findByMenuId"
resultMap="menuCatalogProjectionResultMap">

SELECT
menu_id,
store_id,
status,
menu_event_version
FROM menu_catalog_projection
WHERE menu_id = #{menuId}

</select>
</mapper>
