<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deliveryinsider.order.domain.order.mapper.OrderProviderChargeMapper">

    <resultMap
            id="orderProviderChargeResultMap"
            type="com.deliveryinsider.order.domain.order.entity.OrderProviderChargeEntity">

        <id property="id" column="id"/>

        <result property="orderId" column="order_id"/>

        <result
                property="chargeType"
                column="charge_type"/>

        <result property="amount" column="amount"/>
        <result property="rate" column="rate"/>

        <result
                property="basisAmount"
                column="basis_amount"/>

        <result
                property="provisional"
                column="provisional"/>

        <result
                property="sourceCode"
                column="source_code"/>

        <result property="createdAt" column="created_at"/>

    </resultMap>

    <insert
            id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO order_provider_charges (
            order_id,
            charge_type,
            amount,
            rate,
            basis_amount,
            provisional,
            source_code
        )
        VALUES (
                   #{orderId},
                   #{chargeType},
                   #{amount},
                   #{rate},
                   #{basisAmount},
                   #{provisional},
                   #{sourceCode}
               )

    </insert>

    <select
            id="findAllByOrderId"
            resultMap="orderProviderChargeResultMap">

        SELECT
            id,
            order_id,
            charge_type,
            amount,
            rate,
            basis_amount,
            provisional,
            source_code,
            created_at
        FROM order_provider_charges
        WHERE order_id = #{orderId}
        ORDER BY id

    </select>

</mapper>
