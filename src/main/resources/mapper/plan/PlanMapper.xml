<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deliveryinsider.billing.domain.plan.mapper.PlanMapper">

    <resultMap
            id="planResultMap"
            type="com.deliveryinsider.billing.domain.plan.entity.PlanEntity">

        <id column="id" property="id"/>

        <result column="code" property="code"/>
        <result column="name" property="name"/>

        <result column="price" property="price"/>
        <result column="currency" property="currency"/>

        <result column="billing_cycle" property="billingCycle"/>

        <result column="enabled" property="enabled"/>

        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>

    </resultMap>

    <select
            id="findAllEnabled"
            resultMap="planResultMap">

        SELECT
            id,
            code,
            name,
            price,
            currency,
            billing_cycle,
            enabled,
            created_at,
            updated_at
        FROM plans
        WHERE enabled = 1
        ORDER BY id

    </select>

    <select
            id="findEnabledByCode"
            resultMap="planResultMap">

        SELECT
            id,
            code,
            name,
            price,
            currency,
            billing_cycle,
            enabled,
            created_at,
            updated_at
        FROM plans
        WHERE code = #{code}
          AND enabled = 1
        LIMIT 1

    </select>

</mapper>
