<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deliveryinsider.platform.domain.catalog.mapper.StoreCatalogProjectionMapper">

<resultMap
        id="storeCatalogProjectionResultMap"
        type="com.deliveryinsider.platform.domain.catalog.entity.StoreCatalogProjection">

    <id
            property="storeId"
            column="store_id"/>

    <result
            property="status"
            column="status"/>

    <result
            property="storeEventVersion"
            column="store_event_version"/>

    <result
            property="deletedAt"
            column="deleted_at"/>

</resultMap>

<select
id="findByStoreId"
resultMap="storeCatalogProjectionResultMap">

SELECT
store_id,
status,
store_event_version,
deleted_at
FROM store_catalog_projection
WHERE store_id = #{storeId}

</select>
</mapper>
