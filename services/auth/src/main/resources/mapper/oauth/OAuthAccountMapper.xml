<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deliveryinsider.auth.oauth.mapper.OAuthAccountMapper">

    <resultMap
        id="oauthAccountResultMap"
        type="com.deliveryinsider.auth.oauth.entity.OAuthAccountEntity"
    >
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result
            property="provider"
            column="provider"
            javaType="com.deliveryinsider.auth.oauth.entity.OAuthProvider"
        />
        <result property="providerUserId" column="provider_user_id"/>
        <result property="providerEmail" column="provider_email"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select
        id="findByProviderAndProviderUserId"
        resultMap="oauthAccountResultMap"
    >
        SELECT
            id,
            user_id,
            provider,
            provider_user_id,
            provider_email,
            created_at,
            updated_at
        FROM oauth_accounts
        WHERE provider = #{provider}
          AND provider_user_id = #{providerUserId}
    </select>

    <select
        id="findByUserIdAndProvider"
        resultMap="oauthAccountResultMap"
    >
        SELECT
            id,
            user_id,
            provider,
            provider_user_id,
            provider_email,
            created_at,
            updated_at
        FROM oauth_accounts
        WHERE user_id = #{userId}
          AND provider = #{provider}
    </select>

    <insert
        id="insert"
        useGeneratedKeys="true"
        keyProperty="id"
    >
        INSERT INTO oauth_accounts (
            user_id,
            provider,
            provider_user_id,
            provider_email
        )
        VALUES (
            #{userId},
            #{provider},
            #{providerUserId},
            #{providerEmail}
        )
    </insert>

</mapper>
